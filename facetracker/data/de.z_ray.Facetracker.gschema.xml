<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
    <schema id="de.z_ray.Facetracker" path="/de/z_ray/facetracker/">

        <key name="webcam-index" type="i">
            <default>0</default>
            <summary>Last used Webcam</summary>
        </key>

        <key name="tracking-model" type="i">
